{
  "name": "next-template",
  "description": "",
  "author": "",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true npx next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types:check": "tsc --noEmit --pretty",
    "clean": "rimraf .next out coverage .swc",
    "commitlint:last": "npx commitlint --from HEAD~1 --to HEAD --verbose || $1",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx}\" --ignore-path .prettierignore .",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\" --ignore-path .prettierignore .",
    "prepare": "node setup-husky.js",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests --watch",
    "test:storybook": "cross-env FORCE_COLOR=1 test-storybook",
    "storybook": "cross-env FORCE_COLOR=1 storybook dev -p 6006",
    "storybook:serve": "http-server storybook-static --port 6006 --silent",
    "build:storybook": "cross-env FORCE_COLOR=1 storybook build -c .storybook -o build/",
    "postinstall": "npx patch-package && node setup-husky.js"
  },
  "dependencies": {
    "@next/bundle-analyzer": "14.2.5",
    "@radix-ui/react-slot": "1.1.0",
    "@t3-oss/env-nextjs": "0.11.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "next": "14.2.5",
    "next-compose-plugins": "2.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/compat": "1.2.2",
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.14.0",
    "@next/eslint-plugin-next": "14.2.21",
    "@storybook/addon-a11y": "8.2.9",
    "@storybook/addon-essentials": "8.2.9",
    "@storybook/addon-interactions": "8.2.9",
    "@storybook/addon-jest": "8.2.9",
    "@storybook/addon-links": "8.2.9",
    "@storybook/blocks": "8.2.9",
    "@storybook/nextjs": "8.2.9",
    "@storybook/react": "8.2.9",
    "@storybook/test": "8.2.9",
    "@storybook/test-runner": "0.19.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.0",
    "@total-typescript/ts-reset": "0.5.1",
    "@types/eslint__js": "8.42.3",
    "@types/node": "20.15.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.2",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/expect": "2.1.2",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "cssnano": "7.0.5",
    "eslint": "9.10.0",
    "eslint-config-next": "15.1.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-storybook": "0.11.1",
    "eslint-plugin-tailwindcss": "3.17.5",
    "eslint-plugin-testing-library": "7.1.1",
    "fetch-mock": "11.1.1",
    "globals": "15.14.0",
    "gzip-size": "7.0.0",
    "http-server": "14.1.1",
    "husky": "9.1.4",
    "jsdom": "25.0.1",
    "lint-staged": "15.2.9",
    "mkdirp": "3.0.1",
    "npm-run-all": "4.1.5",
    "patch-package": "8.0.0",
    "postcss": "8.4.41",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.6",
    "rimraf": "6.0.1",
    "start-server-and-test": "2.0.8",
    "storybook": "8.2.9",
    "tailwindcss": "3.4.10",
    "ts-node": "10.9.2",
    "typescript": "5.1.6",
    "typescript-eslint": "8.13.0",
    "vite-tsconfig-paths": "^5.1.4",
