{
	"name": "next-template",
	"description": "",
	"author": "",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env FORCE_COLOR=1 next dev --turbopack",
		"build": "next build",
		"analyze": "cross-env ANALYZE=true npx next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --fix --unsafe",
		"types:check": "tsc --noEmit --pretty",
		"clean": "rimraf .next out coverage .swc .nyc_output reports",
		"commitlint:last": "npx commitlint --from HEAD~1 --to HEAD --verbose || $1",
		"format": "biome check --linter-enabled=false --formatter-enabled=true --organize-imports-enabled=true \"**/*.{js,jsx,ts,tsx}\"",
		"format:fix": "biome check --linter-enabled=false --formatter-enabled=true --organize-imports-enabled=true --write \"**/*.{js,jsx,ts,tsx}\"",
		"prepare": "node setup-husky.js",
		"unit:run": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
		"unit:watch": "vitest --passWithNoTests --watch",
		"unit:coverage": "cross-env FORCE_COLOR=1 vitest run --coverage --passWithNoTests",
		"cy:open": "cypress open --config-file cypress.config.ts",
		"cy:run": "cypress run --config-file cypress.config.ts",
		"cy:serve:ci": "start-server-and-test dev http-get://127.0.0.1:3000 cy:run",
		"cy:serve:app": "start-server-and-test dev http-get://127.0.0.1:3000 cy:open",
		"cover:unit": "nyc --silent pnpm unit:coverage",
		"cover:e2e": "nyc --silent --no-clean pnpm cy:serve:ci",
		"cover:report": "node ./coverage.mjs",
		"cover": "rimraf coverage .nyc_output reports && pnpm unit:coverage && pnpm cy:serve:ci && pnpm cover:report",
		"test:storybook": "cross-env FORCE_COLOR=1 test-storybook",
		"storybook": "cross-env FORCE_COLOR=1 storybook dev -p 6006",
		"storybook:serve": "http-server storybook-static --port 6006 --silent",
		"build:storybook": "cross-env FORCE_COLOR=1 storybook build -c .storybook -o build/",
		"postinstall": "npx patch-package && node setup-husky.js"
	},
	"dependencies": {
		"@next/bundle-analyzer": "15.1.2",
		"@radix-ui/react-slot": "1.1.1",
		"@t3-oss/env-nextjs": "0.11.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"next": "15.1.2",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"sharp": "0.33.5",
		"tailwind-merge": "2.6.0",
		"zod": "3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "19.6.1",
		"@commitlint/config-conventional": "19.6.0",
		"@cypress/code-coverage": "3.13.9",
		"@cypress/webpack-preprocessor": "6.0.2",
		"@istanbuljs/nyc-config-typescript": "1.0.2",
		"@storybook/addon-a11y": "8.4.7",
		"@storybook/addon-essentials": "8.4.7",
		"@storybook/addon-interactions": "8.4.7",
		"@storybook/addon-links": "8.4.7",
		"@storybook/blocks": "8.4.7",
		"@storybook/nextjs": "8.4.7",
		"@storybook/react": "8.4.7",
		"@storybook/test": "8.4.7",
		"@storybook/test-runner": "0.21.0",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.1.0",
		"@total-typescript/ts-reset": "0.5.1",
		"@types/cypress": "1.1.6",
		"@types/node": "22.10.2",
		"@types/react": "19.0.2",
		"@types/react-dom": "19.0.2",
		"@vitejs/plugin-react": "4.3.4",
		"@vitest/coverage-istanbul": "2.1.8",
		"@vitest/coverage-v8": "2.1.8",
		"@vitest/expect": "2.1.2",
		"autoprefixer": "10.4.20",
		"babel-plugin-istanbul": "7.0.0",
		"cross-env": "7.0.3",
		"cypress": "13.17.0",
		"fetch-mock": "12.2.0",
		"gzip-size": "7.0.0",
		"http-server": "14.1.1",
		"husky": "9.1.7",
		"jsdom": "25.0.1",
		"lint-staged": "15.2.11",
		"mkdirp": "3.0.1",
		"npm-run-all": "4.1.5",
		"nyc": "17.1.0",
		"patch-package": "8.0.0",
		"postcss": "8.4.49",
		"rimraf": "6.0.1",
		"start-server-and-test": "2.0.9",
		"storybook": "8.4.7",
		"tailwindcss": "3.4.17",
		"ts-loader": "9.5.1",
		"ts-node": "10.9.2",
		"typescript": "5.1.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "2.1.8",
		"vitest-fail-on-console": "0.7.1"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"keywords": []
}
