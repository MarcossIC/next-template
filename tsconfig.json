{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "target": "es5",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "removeComments": true,
    "alwaysStrict": true,
    "preserveConstEnums": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": false,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "types": [
      "node",
      "vitest/globals",
      "cypress"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@test/*": [
        "./__test__/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@environment": [
        "./env.ts"
      ],
      "@root/*": [
        "*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "types.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/*.ts",
    "next.config.mts"
  ],
  "exclude": [
    "./out/**/*",
    "./node_modules/**/*",
  ]
}
