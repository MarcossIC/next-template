{
	"extends": "@istanbuljs/nyc-config-typescript",
	"all": true,
	"report-dir": "coverage/cypress",
	"include": ["src/**/*.{js,ts,jsx,tsx}"],
	"exclude": [
		"**/*.d.ts",
		"**/*.test.{js,ts,jsx,tsx}",
		"**/*.spec.{js,ts,jsx,tsx}",
		"**/*.cy.{js,ts,jsx,tsx}",
		"coverage/**",
		"test/**",
		"__test__/**",
		"node_modules/**",
		"public/**",
		".next/**",
		".swc/**",
		"..storybook",
		".husky",
		"**/*.stories.{js,ts,jsx,tsx}"
	],
	"reporter": ["text", "html", "lcov", "json"],
	"temp-dir": ".nyc_output",
	"check-coverage": true,
	"branches": 80,
	"lines": 80,
	"functions": 80,
	"statements": 80
}
